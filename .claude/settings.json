{
  "env": {
    "PATH": "/opt/homebrew/bin:${env:PATH}"
  },
  "extraKnownMarketplaces": {
    "lastmyle": {
      "source": {
        "source": "github",
        "repo": "lastmyle/claude-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "lastmyle-shared@lastmyle": true,
    "claude-md-management@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/collision-check.sh"
          }
        ]
      }
    ]
  }
}
